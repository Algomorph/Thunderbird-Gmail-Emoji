{
  "manifest_version": 3,
  "name": "Gmail Emoji Reactions",
  "version": "0.1.0",
  "description": "Send Gmail-native emoji reactions from Thunderbird.",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-gmail-emoji@algomorph",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  }
}
