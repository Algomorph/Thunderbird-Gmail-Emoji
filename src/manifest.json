{
  "manifest_version": 3,
  "name": "Gmail Emoji Reactions",
  "version": "0.1.0",
  "description": "Send Gmail-native emoji reactions from Thunderbird.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-gmail-emoji@algomorph",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "message_display_action": {
    "default_popup": "popup/popup.html",
    "default_title": "React",
    "default_label": "React",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "compose",
    "compose.send",
    "storage",
    "notifications"
  ],
  "options_ui": {
    "page": "options/options.html"
  }
}
