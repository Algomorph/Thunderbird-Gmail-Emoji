{
  "manifest_version": 3,
  "name": "Reaction MIME harness",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "reaction-harness@local", "strict_min_version": "128.0" } },
  "background": { "scripts": ["background.js"], "type": "module" },
  "permissions": ["accountsRead", "accountsFolders", "messagesRead", "messagesImport", "compose", "compose.save", "compose.send", "storage"]
}
